@model OrderLineEditModel

<div class="modal fade" id="lineModal" tabindex="-1" aria-labelledby="lineModalTitle" aria-hidden="true">
    <div class="modal-dialog">
        <form asp-action="SaveLine" method="post" class="modal-content" id="lineForm">
            <div class="modal-header">
                <h2 class="modal-title h5" id="lineModalTitle">Order line</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" asp-for="OrderNumber" />
                <input type="hidden" asp-for="ReturnUrl" />
                <input type="hidden" asp-for="Line.LineNumber" />
                <div class="mb-3">
                    <label asp-for="Line.ProductCode" class="form-label"></label>
                    <input asp-for="Line.ProductCode" class="form-control text-uppercase" />
                    <span asp-validation-for="Line.ProductCode" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Line.ProductType" class="form-label"></label>
                    <select asp-for="Line.ProductType" class="form-select" asp-items="Html.GetEnumSelectList<ProductType>()"></select>
                    <span asp-validation-for="Line.ProductType" class="text-danger small"></span>
                </div>
                <div class="row g-2">
                    <div class="col">
                        <label asp-for="Line.CostPrice" class="form-label"></label>
                        <input asp-for="Line.CostPrice" type="text" inputmode="decimal" class="form-control" value="" />
                        <span asp-validation-for="Line.CostPrice" class="text-danger small"></span>
                    </div>
                    <div class="col">
                        <label asp-for="Line.SalesPrice" class="form-label"></label>
                        <input asp-for="Line.SalesPrice" type="text" inputmode="decimal" class="form-control" value="" />
                        <span asp-validation-for="Line.SalesPrice" class="text-danger small"></span>
                    </div>
                    <div class="col">
                        <label asp-for="Line.Quantity" class="form-label"></label>
                        <input asp-for="Line.Quantity" type="text" inputmode="numeric" class="form-control" value=""
                               data-val-regex="Quantity must be a whole number." data-val-regex-pattern="^\d+$" />
                        <span asp-validation-for="Line.Quantity" class="text-danger small"></span>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary">Save line</button>
            </div>
        </form>
    </div>
</div>
